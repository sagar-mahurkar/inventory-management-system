NODE_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173

# PostgreSQL connection
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=inventory_management
DATABASE_USER=postgres
DATABASE_PASSWORD=replace_with_your_local_password

# Database used only to check/create DATABASE_NAME.
# The configured user must have permission to CREATE DATABASE.
DATABASE_ADMIN_DB=postgres
